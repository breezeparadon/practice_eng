# Database (local: docker compose; production: Supabase pooled URL)
DATABASE_URL=postgresql://wordbook:wordbook@localhost:5440/wordbook
# Auth.js
AUTH_SECRET=            # openssl rand -base64 32
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ALLOWED_EMAILS=         # comma-separated; only these can sign in
# Local development only (ignored in production)
DEV_LOGIN=false
DEV_LOGIN_EMAIL=dev@localhost
