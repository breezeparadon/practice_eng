# Database
# Local: docker compose. Production (Supabase):
#   DATABASE_URL = transaction pooler, port 6543 (used by the app)
#   DIRECT_URL   = session pooler, port 5432                               (used by migrate and seed)
DATABASE_URL=postgresql://wordbook:wordbook@localhost:5440/wordbook
DIRECT_URL=
# Auth.js
AUTH_SECRET=            # openssl rand -base64 32
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ALLOWED_EMAILS=         # comma-separated; only these can sign in
# Local development only (ignored in production)
DEV_LOGIN=false
DEV_LOGIN_EMAIL=dev@localhost
