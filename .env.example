# Database
# Local: docker compose (below). Production: Vercel → Storage → Neon Postgres, which sets
# DATABASE_URL (pooled, used by the app) and DATABASE_URL_UNPOOLED (used by migrate and seed).
DATABASE_URL=postgresql://wordbook:wordbook@localhost:5440/wordbook

# Optional single-owner passcode. Unset = the site is open (no sign-in).
APP_PASSCODE=
